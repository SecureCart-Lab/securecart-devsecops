# Normalize text files and keep Linux-executed files on LF line endings.
* text=auto

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.tf   text eol=lf
*.xml  text eol=lf
*.java text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
